      },
      {
        "ingredientId": "light_soy_sauce",
        "amount": "适量"
      },
      {
        "ingredientId": "peanut_oil",
        "amount": "适量"
      },
      {
        "ingredientId": "salt",
        "amount": "少许"
      }
    ],
    "steps": [
      "菜心洗净，太粗的菜梗纵向剖开。",
      "锅中多加水，大火烧开，加入花生油和盐让青菜保持翠绿。",
      "先烫菜心根部10秒，再整根放入焯烫约1分钟，捞出控干码盘。",
      "撒姜丝，淋热花生油，最后在盘边淋一圈生抽。"
