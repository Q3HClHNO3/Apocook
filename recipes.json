        "amount": "1个"
      },
      {
        "ingredientId": "rock_sugar",
        "amount": "几粒"
      },
      {
        "ingredientId": "light_soy_sauce",
        "amount": "适量"
      },
      {
        "ingredientId": "cooking_wine",
        "amount": "适量"
      }
    ],
