[
  {
    "id": "cantonese_steamed_fish",
    "name": "广式清蒸鱼",
    "cityId": "Guangzhou",
    "category": [
      "粤菜",
      "家常菜",
      "蒸菜"
    ],
    "description": "乖孙，在广州吃鱼，最紧要是买活鱼。清蒸最能吃出鱼的鲜味，火候、蒸鱼豉油和花生油都要讲究。",
    "ingredients": [
      {
        "ingredientId": "fresh_sea_bass",
        "amount": "1条"
      },
      {
        "ingredientId": "ginger",
        "amount": "适量"
      },
      {
        "ingredientId": "scallion",
        "amount": "适量"
      },
      {
        "ingredientId": "red_shallot",
        "amount": "适量"
      },
      {
        "ingredientId": "seasoned_soy_sauce_for_seafood",
        "amount": "适量"
      },
      {
        "ingredientId": "peanut_oil",
        "amount": "2大勺"
      }
    ],
    "steps": [
      "鱼清洗干净，用厨房纸吸干水分，在鱼身两面各划几刀。",
      "盘底和鱼肚子放姜片、红葱头，水开后猛火蒸7-8分钟，熄火虚蒸2分钟。",
      "倒掉盘中的蒸鱼水，去掉旧姜葱。",
      "铺新的细姜丝、红葱丝和葱尾丝，淋滚烫花生油激香，最后沿盘边淋入蒸鱼豉油。"
    ],
    "story": "阿婆常说，清蒸鱼看鱼肉有没有刚好脱骨。花生油香配豉油，用来捞饭能吃两碗。"
  },
  {
    "id": "dried_night_blooming_cereus_pork_bone_soup",
    "name": "霸王花猪骨汤",
    "cityId": "Guangzhou",
    "category": [
      "粤菜",
      "汤水"
    ],
    "description": "广州湿热天气里很适合的一锅清润汤水，讲究清水、慢火和瓦煲的温润。",
    "ingredients": [
      {
        "ingredientId": "pork_bone",
        "amount": "适量"
      },
      {
        "ingredientId": "dried_night_blooming_cereus",
        "amount": "适量"
      },
      {
        "ingredientId": "candied_date",
        "amount": "2颗"
      },
      {
        "ingredientId": "chenpi",
        "amount": "一小块"
      },
      {
        "ingredientId": "apricot_kernel",
        "amount": "适量"
      },
      {
        "ingredientId": "ginger",
        "amount": "适量"
      },
      {
        "ingredientId": "salt",
        "amount": "少许"
      }
    ],
    "steps": [
      "干霸王花用温水泡发，洗净剪开；陈皮泡软后刮去内囊白络。",
      "猪骨冷水下锅焯水，煮出浮沫后捞出并用温水冲净。",
      "瓦煲一次性加足清水，放入猪骨、姜片、陈皮、蜜枣和南北杏，大火烧开。",
      "烧开后倒入霸王花，转小火煲1.5到2小时，出锅前5分钟加盐。"
    ],
    "story": "在广州，一看到天气变了，厨房里就会响起瓦煲汤沸声。一碗老火靓汤喝下去，整个人都温润了。"
  },
  {
